{
  "name": "piu-best50-plugin",
  "version": "0.4.0",
  "description": "PIU Pumbility Best50 image generator and Yunzai plugin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "demo": "node bin/piu.js render examples/demo.json best50-demo.jpg",
    "start": "node bin/piu.js serve",
    "setup": "node bin/piu.js setup",
    "browser:install": "playwright install chromium",
    "assets:download": "node bin/download-badges.js",
    "rank:daemon": "node bin/piu.js rank-daemon",
    "rank:capture": "node bin/piu.js rank-capture"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "cheerio": "1.2.0",
    "playwright": "1.64.1",
    "qrcode": "1.5.4",
    "yaml": "^2.4.0"
  },
  "license": "MIT"
}
