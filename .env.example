# npm run setup 自动生成本地 .env 和随机加密密钥
PIU_PUBLIC_URL=http://localhost:3210
PIU_HOST=127.0.0.1
PIU_PORT=3210
PIU_SESSION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
PIU_LOGIN_SECONDS=300
PIU_MAX_LOGINS=3
PIU_MAX_FETCHES=2
PIU_CACHE_SECONDS=120
PIU_SESSION_DAYS=14
# 每日 GMT+8 01:00 保存全球前 1000 名完整快照；失败后当天每 30 分钟补采至成功；机器人需要持续运行
PIU_RANK_ENABLED=true
# 排行榜须登录：主人私聊 #piu ranklogin sid=会话值 直接导入；不带参数仍扫码（使用上方密钥加密）
# 会话保活间隔，单位分钟；填 0 关闭保活
PIU_RANK_KEEPALIVE_MINUTES=20
# 单轮抓取失败后的短间隔重试次数（不含首次尝试）；不影响当天每 30 分钟补采
PIU_RANK_CAPTURE_RETRIES=2
# 首次授权排行榜采集时预存的曲绘页数；0 关闭自动预存（B50 缺图仍会自动下载保存）
PIU_JACKET_PREFETCH_PAGES=3
PIU_JACKET_PREFETCH_IMAGES=120
# 安装 Playwright Chromium 后留空；或填写本机 Chrome 路径
PIU_BROWSER_PATH=
